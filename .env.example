# Copy this file to .env and fill in your key. .env is gitignored — never commit real keys.

# Optional AI Parse (Gemini) ke liye. Key na ho to button builder mein disabled
# dikhta hai — app crash nahi karta. Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# Set true to force-disable AI Parse regardless of GEMINI_API_KEY (e.g. for a
# deployment that shouldn't send page images to Google at all).
# FORMFORGE_AI_DISABLED=false

# Comma-separated allowed origins for the API. Defaults to "*" (open) — fine for
# local dev, but for a real deployment restrict this to your frontend's domain.
# FORMFORGE_CORS_ORIGINS=https://yourdomain.com

# Max PDF upload size in MB. Defaults to 20.
# FORMFORGE_MAX_UPLOAD_MB=20
